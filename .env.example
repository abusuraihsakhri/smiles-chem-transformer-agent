# Smiles Chem Transformer Agent - Environment Configuration
# Copy this file to .env and update values for production

# Required: Secret key for HMAC-SHA256 audit trail signing
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=change-me-in-production-use-secure-random-key

# LLM Provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock
