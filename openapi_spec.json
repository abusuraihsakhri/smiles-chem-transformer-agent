{
  "openapi": "3.1.0",
  "info": {
    "title": "SMILES Chem Transformer Agent API",
    "version": "3.1.0",
    "description": "RDKit-backed molecular analysis and legacy rule-based audit. Runtime schema is available from /openapi.json."
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Serve local browser workbench",
        "responses": {
          "200": {
            "description": "HTML workbench"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health metadata",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON operational counters",
        "responses": {
          "200": {
            "description": "Counters as JSON, not Prometheus exposition format"
          }
        }
      }
    },
    "/api/molecule": {
      "post": {
        "summary": "Analyze SMILES with RDKit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "smiles"
                ],
                "properties": {
                  "smiles": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "max_tautomers": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calculated canonical SMILES, formula, masses, InChI when supported and tautomers"
          },
          "422": {
            "description": "SMILES validation error"
          },
          "503": {
            "description": "RDKit unavailable"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy threshold audit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number",
                    "default": 0
                  },
                  "status_descriptor": {
                    "type": "string",
                    "default": "NOMINAL"
                  },
                  "is_critical_flag": {
                    "type": "boolean",
                    "default": false
                  },
                  "attributes": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule-based consensus dossier"
          },
          "422": {
            "description": "Input validation or sensitive identifier rejection"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock supervisor response",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "400": {
            "description": "Invalid query"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-memory signed audit log metadata",
        "responses": {
          "200": {
            "description": "Audit trail entries and verification result"
          }
        }
      }
    }
  }
}
